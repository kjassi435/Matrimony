{
    "version": 2,
    "builds": [
        {
            "src": "api/index.mjs",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "public/build/$1"
        },
        {
            "src": "/(.*)",
            "dest": "api/index.mjs"
        }
    ]
}
