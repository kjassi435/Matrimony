{
    "version": 2,
    "builds": [
        {
            "src": "api/index.mjs",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "public/build/$1"
        },
        {
            "src": "/(.*)",
            "dest": "api/index.mjs"
        }
    ],
    "env": {
        "TURSO_DB_URL": "@turso-db-url",
        "TURSO_AUTH_TOKEN": "@turso-auth-token",
        "COOKIE_SECRET": "@cookie-secret"
    }
}
